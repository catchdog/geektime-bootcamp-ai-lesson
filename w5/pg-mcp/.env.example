# ============================================================================
# PostgreSQL MCP Server - Environment Configuration
# ============================================================================
# Copy this file to .env and configure with your actual values
# DO NOT commit .env to version control - it contains sensitive credentials
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Two mutually compatible modes:
#
#   Mode A (single database, legacy): set the DATABASE_* variables below.
#   Mode B (multi-database): set DATABASES to a JSON list (see the
#   MULTI-DATABASE CONFIGURATION section at the bottom). Each entry uses the
#   same fields as DatabaseConfig; entries only need to override what differs
#   from the DATABASE_* defaults.
#
# If DATABASES is not set, the server falls back to the single DATABASE_*
# configuration, so existing single-database setups keep working unchanged.

# Database host (IP address or hostname)
# Examples: localhost, 192.168.1.100, db.example.com, postgres
DATABASE_HOST=localhost

# Database port (default PostgreSQL port is 5432)
DATABASE_PORT=5432

# Database name to connect to
# This should be an existing database that the user has access to
DATABASE_NAME=blog_small

# Database user for authentication
# SECURITY: Use a read-only user in production (see README.md Security section)
DATABASE_USER=postgres

# Database password
# SECURITY: Keep this secure and never commit to version control
DATABASE_PASSWORD=postgres

# Per-database name used as the identifier clients pass to the
# `query` tool's `database` parameter (single-database mode)
# With more than one configured database, every request MUST name one.

# ============================================================================
# DATABASE CONNECTION POOL SETTINGS
# ============================================================================
# Configure connection pooling for optimal performance and resource usage

# Minimum number of connections to maintain in the pool
# Lower values save resources, higher values reduce connection setup latency
# Recommended: 5-10 for most use cases
DATABASE_MIN_POOL_SIZE=5

# Maximum number of connections allowed in the pool
# Should be less than PostgreSQL's max_connections setting
# Recommended: 10-50 depending on expected concurrent queries
DATABASE_MAX_POOL_SIZE=20

# Connection pool acquisition timeout in seconds
# How long to wait for an available connection before timing out
# Recommended: 10-30 seconds
DATABASE_POOL_TIMEOUT=30

# Query execution timeout in seconds
# Maximum time a single query can run before being cancelled
# Prevents runaway queries from consuming resources
# Recommended: 30-60 seconds
DATABASE_COMMAND_TIMEOUT=30

# ============================================================================
# OPENAI CONFIGURATION
# ============================================================================
# OpenAI API settings for LLM-powered SQL generation and validation

# OpenAI API key (required)
# Get your key from: https://platform.openai.com/api-keys
# SECURITY: Never commit this to version control
# OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI model to use for SQL generation
# Recommended models:
#   - gpt-5.2-mini: Fast, cost-effective, good for SQL generation
#   - gpt-4o: More accurate for complex queries, higher cost
#   - gpt-4o-mini: Balance of speed and accuracy
OPENAI_MODEL=gpt-5.2-mini

# Maximum tokens for LLM requests
# Controls the maximum length of generated SQL and responses
# gpt-5.2-mini supports up to 128k tokens context
# Recommended: 32000 for most use cases
OPENAI_MAX_TOKENS=32000

# Model temperature (0.0 = deterministic, 2.0 = creative)
# For SQL generation, use 0.0 for consistent, predictable outputs
# Higher values introduce randomness (not recommended for SQL)
OPENAI_TEMPERATURE=0.0

# API request timeout in seconds
# How long to wait for OpenAI API responses
# Recommended: 30-60 seconds
OPENAI_TIMEOUT=30

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
# Security settings to protect your database from unauthorized operations

# Comma-separated list of tables queries must not access.
# Matches bare table names ("secret_data") and schema-qualified names
# ("private.credentials"). Requests touching them are rejected with
# SECURITY_VIOLATION.
# Example: SECURITY_BLOCKED_TABLES=secret_data,users.passwords
SECURITY_BLOCKED_TABLES=

# Comma-separated list of columns queries must not access.
# Matches bare column names ("password_hash") and table-qualified names
# ("users.api_key").
# Example: SECURITY_BLOCKED_COLUMNS=password_hash,users.api_key
SECURITY_BLOCKED_COLUMNS=

# Allow plain EXPLAIN statements (query plans only, nothing executes).
# Default: false. SECURITY NOTE: EXPLAIN ANALYZE is ALWAYS rejected even
# when this is true, because ANALYZE actually executes the inner statement.
SECURITY_ALLOW_EXPLAIN=false

# Comma-separated list of blocked PostgreSQL functions
# These functions are security risks and will be rejected during validation
# Includes: file I/O, sleep functions, admin functions, etc.
# Add additional functions as needed for your security requirements
SECURITY_BLOCKED_FUNCTIONS=pg_sleep,pg_read_file,pg_write_file,lo_import,lo_export,pg_ls_dir,pg_read_binary_file,pg_stat_file,copy_from_program,copy_to_program

# Maximum number of rows returned per query
# Prevents memory exhaustion from extremely large result sets
# Recommended: 1000-10000 depending on your use case
SECURITY_MAX_ROWS=10000

# Maximum query execution time in seconds
# Queries exceeding this time will be cancelled
# Recommended: 30-60 seconds
SECURITY_MAX_EXECUTION_TIME=30

# PostgreSQL role to switch to for query execution (SET ROLE).
# When set, queries run with this role's privileges - use a read-only
# role in production for defense in depth.
# SECURITY_READONLY_ROLE=readonly

# Comma-separated search_path applied to every query session.
# Prevents schema injection attacks. Keep as "public" unless you know
# you need otherwise.
SECURITY_SAFE_SEARCH_PATH=public

# ============================================================================
# VALIDATION CONFIGURATION
# ============================================================================
# Settings for input validation and result verification

# Maximum question length in characters
# Questions longer than this are rejected with question_too_long before
# any LLM call is made.
# Recommended: 5000-10000 characters
VALIDATION_MAX_QUESTION_LENGTH=10000

# Minimum confidence score for accepting query results (0-100)
# Results below this score get a `warning` attached to the response;
# results the LLM validator marks unacceptable are rejected entirely
# with a low_confidence error.
# Recommended: 70-80 for most use cases
VALIDATION_MIN_CONFIDENCE_SCORE=70

# Enable LLM-based result validation (does the result answer the question?)
# Disable to skip the second LLM call per query (faster, cheaper).
VALIDATION_ENABLED=true

# Number of sample rows sent to the LLM validator
VALIDATION_SAMPLE_ROWS=5

# LLM validator request timeout in seconds
VALIDATION_TIMEOUT_SECONDS=10

# Confidence threshold the LLM validator uses for its accept/reject verdict
VALIDATION_CONFIDENCE_THRESHOLD=70

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
# Schema caching settings to improve performance

# Enable schema caching
# When enabled, database schema is cached to reduce metadata queries
# Recommended: true for production
CACHE_ENABLED=true

# Schema cache Time-To-Live in seconds
# How long to keep cached schema before refreshing
# Recommended: 3600 (1 hour) for mostly static schemas
# Use lower values if schema changes frequently
CACHE_SCHEMA_TTL=3600

# Maximum number of database schemas to cache (LRU eviction beyond this)
# Controls memory usage for multi-database deployments
# Recommended: 100 (more than enough for most use cases)
CACHE_MAX_SIZE=100

# ============================================================================
# RESILIENCE CONFIGURATION
# ============================================================================
# Settings for rate limiting, retry logic, circuit breakers, fault tolerance

# Maximum concurrent query executions (whole pipeline per request)
# Additional requests wait up to RESILIENCE_RATE_LIMIT_TIMEOUT seconds for
# a free slot, then fail with a rate_limit_exceeded error.
# Recommended: 10 for interactive use
RESILIENCE_MAX_CONCURRENT_QUERIES=10

# Maximum concurrent LLM API calls (SQL generation + result validation)
# Protects the OpenAI API from bursts; set below your API tier limit.
RESILIENCE_MAX_CONCURRENT_LLM_CALLS=5

# Seconds to wait for a rate limiter slot before returning rate_limit_exceeded
# Recommended: 5 for interactive use (lets short bursts through)
RESILIENCE_RATE_LIMIT_TIMEOUT=5

# Maximum number of retry attempts for failed SQL generation/validation
# Applies to the LLM feedback loop (validation failures regenerate SQL
# with error feedback).
# Recommended: 2-3 retries
RESILIENCE_MAX_RETRIES=3

# Initial retry delay in seconds
# Time to wait before first retry attempt (LLM feedback loop and DB retries)
RESILIENCE_RETRY_DELAY=1.0

# Exponential backoff factor for retries
# Each retry waits (delay * factor^attempt) seconds
# Example with factor=2.0: 1s, 2s, 4s, 8s
RESILIENCE_BACKOFF_FACTOR=2.0

# Retries for TRANSIENT database errors (connection dropped, restart, ...)
# with exponential backoff. Non-transient SQL errors are never retried.
# 0 disables database retries.
RESILIENCE_DB_RETRY_ATTEMPTS=3

# Circuit breaker failure threshold
# Number of consecutive LLM failures before opening circuit
# When circuit is open, requests fail fast with llm_error
# Recommended: 5-10 failures
RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5

# Circuit breaker timeout in seconds
# How long to wait before attempting to close circuit (test if service recovered)
# Recommended: 60-120 seconds
RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=60

# ============================================================================
# OBSERVABILITY CONFIGURATION
# ============================================================================
# Settings for metrics, tracing, logging, and monitoring

# Enable Prometheus metrics endpoint
# When enabled, metrics are exposed on the metrics port (e.g.
# pg_mcp_query_requests_total, pg_mcp_llm_tokens_used, pg_mcp_db_query_duration_seconds)
OBSERVABILITY_METRICS_ENABLED=true

# Port for Prometheus metrics HTTP server
# Make sure this port is available and not blocked by firewall
OBSERVABILITY_METRICS_PORT=9090

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Recommended: INFO for production, DEBUG for development
OBSERVABILITY_LOG_LEVEL=INFO

# Log format
# Options: json, text
# Every log line carries the request_id of the query it belongs to, so
# logs can be correlated per request across all pipeline stages
# (sql_generation / sql_validation / sql_execution / result_validation).
OBSERVABILITY_LOG_FORMAT=json

# ============================================================================
# ENVIRONMENT
# ============================================================================
# Application environment identifier

# Environment name (development, staging, production)
# Used for logging context
ENVIRONMENT=development

# ============================================================================
# MULTI-DATABASE CONFIGURATION (Mode B)
# ============================================================================
# Set DATABASES to a JSON list to serve multiple databases. Each entry is a
# DatabaseConfig; unset fields inherit the DATABASE_* defaults above.
# With more than one database configured, the query tool's `database`
# parameter becomes MANDATORY (requests without it get a BAD_REQUEST-style
# error listing the available databases).
#
# Example:
# DATABASES=[{"name":"prod","host":"db.example.com","password":"secret1","user":"readonly"},{"name":"analytics","host":"db2.example.com","port":5433,"password":"secret2","user":"readonly"}]
#
# NOTES:
# - All pools are created at startup; if any database is unreachable the
#   server fails to start (fail-fast by design).
# - Blocked tables/columns and EXPLAIN policy apply uniformly to all
#   configured databases (single security policy).

# ============================================================================
# CONFIGURATION VALIDATION CHECKLIST
# ============================================================================
# Before running the server, verify:
# [ ] Database credentials are correct (test with: psql -h $HOST -U $USER -d $NAME)
# [ ] OpenAI API key is valid and has credits
# [ ] Security settings are appropriate for your use case
# [ ] Resource limits (max_rows, timeout) match your requirements
# [ ] Logging and metrics are configured for your monitoring setup
# [ ] .env file is NOT committed to version control (.gitignore contains .env)
#
# For production deployments, also verify:
# [ ] Using read-only database user and/or SECURITY_READONLY_ROLE
# [ ] SECURITY_BLOCKED_TABLES / SECURITY_BLOCKED_COLUMNS cover sensitive objects
# [ ] SECURITY_ALLOW_EXPLAIN=false (or consciously enabled)
# [ ] Appropriate connection pool sizes for expected load
# [ ] Monitoring and alerting configured for metrics endpoint
# [ ] Secrets are stored in secure secret management system (not .env)
